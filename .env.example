# Copie este arquivo para .env.local (o Git ignora) e preencha só o que quiser trocar.
# Sem .env.local, o app usa os valores de src/config.js, que são os do site publicado.

# Supabase do FargusThreads (por exemplo, um projeto separado para testes)
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Supabase do FargusGram (logins, jogadores e personagens)
VITE_GRAM_URL=
VITE_GRAM_KEY=

# Endereço do FargusGram publicado
VITE_GRAM_SITE=
